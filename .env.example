# Frontend Firebase Configuration (Client-safe, Vite)
VITE_FIREBASE_API_KEY=AIzaSyBharatHeritageDemoApiKey123456789
VITE_FIREBASE_AUTH_DOMAIN=bharat-heritage.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bharat-heritage
VITE_FIREBASE_STORAGE_BUCKET=bharat-heritage.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=109876543210
VITE_FIREBASE_APP_ID=1:109876543210:web:abcdef1234567890
VITE_API_BASE_URL=https://bharat-heritage.onrender.com

# Backend Firebase Admin Configuration (Server-side on Render ONLY)
# Never expose these on the client!
PORT=3000
FIREBASE_PROJECT_ID=bharat-heritage
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@bharat-heritage.iam.gserviceaccount.com
# Provide the private key or service account on Render:
FIREBASE_PRIVATE_KEY=your_private_key_set_in_render_environment_only
# Or provide the complete service account JSON as a string on Render:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Google Gemini API Key (Optional for live AI Heritage Guide on Render)
GEMINI_API_KEY=your_gemini_api_key_here

